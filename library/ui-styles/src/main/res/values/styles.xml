<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="VectorEmptyImageView">
        <item name="android:visibility">visible</item>
    </style>

    <!-- ROMANTIC THEME - Cerlita -->
    <style name="Theme.Vector.Romantic" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary colors - Romantic palette -->
        <item name="colorPrimary">@color/romantic_primary</item>
        <item name="colorPrimaryVariant">@color/romantic_primary_variant</item>
        <item name="colorOnPrimary">@color/romantic_on_primary</item>
        <item name="colorSecondary">@color/romantic_secondary</item>
        <item name="colorSecondaryVariant">@color/romantic_secondary_variant</item>
        <item name="colorOnSecondary">@color/romantic_on_secondary</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/romantic_background</item>
        <item name="colorSurface">@color/romantic_surface</item>
        <item name="colorOnBackground">@color/romantic_on_background</item>
        <item name="colorOnSurface">@color/romantic_on_surface</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/romantic_status_bar</item>
        <item name="android:navigationBarColor">@color/romantic_navigation_bar</item>
        
        <!-- Accent -->
        <item name="colorAccent">@color/romantic_accent</item>
        
        <!-- Error -->
        <item name="colorError">@color/romantic_error</item>
        <item name="colorOnError">@color/romantic_on_error</item>
    </style>

    <!-- ROMANTIC DARK THEME -->
    <style name="Theme.Vector.Romantic.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary colors - Romantic dark palette -->
        <item name="colorPrimary">@color/romantic_primary_dark</item>
        <item name="colorPrimaryVariant">@color/romantic_primary_variant_dark</item>
        <item name="colorOnPrimary">@color/romantic_on_primary_dark</item>
        <item name="colorSecondary">@color/romantic_secondary_dark</item>
        <item name="colorSecondaryVariant">@color/romantic_secondary_variant_dark</item>
        <item name="colorOnSecondary">@color/romantic_on_secondary_dark</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/romantic_background_dark</item>
        <item name="colorSurface">@color/romantic_surface_dark</item>
        <item name="colorOnBackground">@color/romantic_on_background_dark</item>
        <item name="colorOnSurface">@color/romantic_on_surface_dark</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/romantic_status_bar_dark</item>
        <item name="android:navigationBarColor">@color/romantic_navigation_bar_dark</item>
        
        <!-- Accent -->
        <item name="colorAccent">@color/romantic_accent_dark</item>
        
        <!-- Error -->
        <item name="colorError">@color/romantic_error_dark</item>
        <item name="colorOnError">@color/romantic_on_error_dark</item>
    </style>

    <!-- ROMANTIC TRANSPARENT THEME (for dialogs and overlays) -->
    <style name="Theme.Vector.Romantic.Transparent" parent="Theme.Vector.Romantic">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

</resources>